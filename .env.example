# Copie este arquivo para ".env" na raiz do repo antes de rodar "docker compose".

# --- Credenciais Postgres compartilhadas (db, etl, api) ---
DB_NAME=dados_rfb
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=db
DB_PORT=5432
DB_HOST_PORT=5432

# --- Modo de teste do ETL (unset/false = comportamento de sempre: import completo) ---
ETL_TEST_MODE=true
ETL_MAX_FILES_PER_TYPE=1
ETL_MAX_ROWS=5000

# --- Diretórios de trabalho do ETL, DENTRO do container ---
OUTPUT_FILES_PATH=/data/output
EXTRACTED_FILES_PATH=/data/extracted

# --- API ---
API_PORT=3000

# --- Carga parcial (opcional; sem estas variáveis a carga é completa) ---
# ETL_FILTER_UF=RJ
# ETL_FILTER_MUNICIPIO=6001          # código da Receita (tabela munic); confira no arquivo *.MUNICCSV extraído
# ETL_FILTER_CNAE_FILE=/data/cnae-icp-ab.csv   # CSV com coluna "codigo" (7 dígitos); filtra a atividade principal
# ETL_SKIP_SOCIOS=true
